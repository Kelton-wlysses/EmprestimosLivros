@using EmprestimosLivros.Dto
@model UsuarioRegisterDto
@{
  ViewData["Title"] = "Registrar";
}

@if (TempData["MensagemSucesso"] != null)
{
  <div class="alert alert-success text-light" role="alert">
    @TempData["MensagemSucesso"]
  </div>
}

@if (TempData["MensagemError"] != null)
{
  <div class="alert alert-danger text-light" role="alert">
    @TempData["MensagemError"]
  </div>
}

<div asp-validation-summary="All" class="text-danger"></div>

<div class="container">

  <h1>Cadastro de Usuários</h1>

  <form asp-action="Registrar" asp-controller="Login" method="post">
    <div class="form-group">
      <label for="email">Email:</label>
      <input type="email" class="form-control" id="email" asp-for="Email" placeholder="Enter email">
    </div>

    <div class="form-group">
      <label for="nome">Nome:</label>
      <input type="text" class="form-control" id="nome" asp-for="Nome" placeholder="Enter email">
    </div>

    <div class="form-group">
      <label for="sobrenome">Sobrenome:</label>
      <input type="text" class="form-control" id="sobrenome" asp-for="Sobrenome" placeholder="Enter email">
    </div>

    <div class="form-group">
      <label for="senha">Senha:</label>
      <input type="password" class="form-control" id="senha" asp-for="Senha" placeholder="Password">
    </div>

    <div class="form-group">
      <label for="senha">Confirma Senha:</label>
      <input type="password" class="form-control" id="senha" asp-for="ConfirmaSenha" placeholder="Password">
    </div>

    <div class="d-flex justify-content-center">
      <button type="submit" class="btn btn-primary w-25 mx-2">Cadastrar</button>
      <a asp-action="Index" asp-controller="Login" class="btn w-25">Voltar</a>
    </div>

  </form>


</div>
