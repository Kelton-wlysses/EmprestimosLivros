@{
  ViewData["Title"] = "Login";
}

@if (TempData["MensagemSucesso"] != null)
{
  <div class="alert alert-success text-light" role="alert">
    @TempData["MensagemSucesso"]
  </div>
}

@if (TempData["MensagemError"] != null)
{
  <div class="alert alert-danger text-light" role="alert">
    @TempData["MensagemError"]
  </div>
}

<div class="container">

  <form>
    <div class="form-group">
      <label for="email">Email:</label>
      <input type="email" class="form-control" id="email" placeholder="Enter email">
    </div>
    <div class="form-group">
      <label for="senha">Senha:</label>
      <input type="password" class="form-control" id="senha" placeholder="Password">
    </div>

    <div class="d-flex justify-content-center">
      <button type="submit" class="btn btn-primary w-25 mx-2">Entrar</button>
      <a asp-action="Registrar" asp-controller="Login" class="btn w-25">Cadastrar-se</a>
    </div>

  </form>

</div>
